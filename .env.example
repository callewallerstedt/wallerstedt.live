DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# When both exist, the Vercel Supabase integration connection takes precedence.
SUPA_POSTGRES_URL=

ACCOUNTING_ACCESS_KEY=
ACCOUNTING_PASSWORD=
# Optional. If empty, the private trading desk uses ACCOUNTING_ACCESS_KEY
# at /trading/<key> — same secret-path style as /vault/<key>.
TRADING_ACCESS_KEY=
ACCOUNTING_SESSION_SECRET=
ACCOUNTING_AGENT_API_TOKEN=
ACCOUNTING_AGENT_HOST=agent.wallerstedt.live
ACCOUNTING_SYNC_TOKEN=
# Optional. The trading agent writes the book at POST /api/trading/<key>/agent
# using the same secret path as the desk. Bearer token is not required.
TRADING_AGENT_API_TOKEN=

TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_CONNECT_SECRET=choose-a-long-random-secret-here
TESLA_REDIRECT_URI=
TESLA_FLEET_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_DOMAIN=wallerstedt.live

# Web Push for the bookkeeping Home Screen PWA and Bolag record reminders (iOS 16.4+).
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact.wallerstedt@gmail.com
# Optional override for notification links in local/preview deploys.
NEXT_PUBLIC_SITE_URL=https://wallerstedt.live

# Treg (https://treg.to) — server-side only. Powers in-app TikTok piano-cover
# search on Företags-OS video ideas. Never expose this token to the browser.
# Set on Vercel Production by Björn.
TREG_TOKEN=

# GPT-Live voice + specialist agents (server-only credentials).
OPENAI_API_KEY=
# Optional; defaults to gpt-realtime.
OPENAI_REALTIME_MODEL=
# Server-only JSON map, keyed by elon, bjorn, jensen, max, nils, jan, rayner.
# Example: {"jensen":{"url":"https://example.com/voice","token":"replace-me"}}
VOICE_AGENT_WEBHOOKS={}
# Legacy Elon fallback when elon is absent from the JSON map.
BOSS_VOICE_WEBHOOK_URL=
BOSS_VOICE_WEBHOOK_TOKEN=
# Optional; defaults to BOSS_VOICE_WEBHOOK_TOKEN for inbound replies.
BOSS_VOICE_INBOX_TOKEN=
